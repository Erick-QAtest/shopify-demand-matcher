# Read-only. Put real values only in your local .env (ignored by git).

# Demand source: csv (export of the events log) or sheets (Google Sheets)
SMART_SOURCE=csv
SMART_CSV_PATH=eventos_log.csv

SMART_SPREADSHEET_ID=
SMART_SHEET_NAME=eventos_log
SMART_RANGE=A:V
GOOGLE_SERVICE_ACCOUNT_FILE=

SMART_DEMAND_EVENTS=PREGUNTA_TALLA_PRECIO,PREGUNTA_MODELO_ESPECIFICO,PRUEBA_MULTIPLES_MODELOS
SMART_ACCEPTED_STATUSES=LOGGED
INCLUDE_PHONE=false

SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional override if you already have an Admin API token
SHOPIFY_ADMIN_ACCESS_TOKEN=

SHOPIFY_API_VERSION=2026-07
SHOPIFY_VARIANT_PAGE_SIZE=50
SHOPIFY_LOCATION_PAGE_SIZE=10
SHOPIFY_MAX_RETRIES=6
SHOPIFY_TIMEOUT_SECONDS=30
SHOPIFY_SIZE_OPTION_NAMES=Talla,Size,Tamaño,Tamano,Shoe Size
OUTPUT_DIR=artifacts
